--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -168,6 +168,9 @@
 static bool gpu_pool_ready;
 static struct { uint64_t start, size; } pool_free[2048];
 static unsigned pool_free_count;
+/* pool use, for the log: bytes in use, the most there has been, allocations that found no room */
+static volatile SInt64 pool_used_bytes, pool_peak_bytes, pool_fails, pool_allocs, pool_frees, pool_dbl;
+static uint64_t pool_logged_peak;
 
 static void
 range_free(void *table, unsigned *count, unsigned max, uint64_t address, uint64_t size)
@@ -258,6 +261,11 @@
 	}
 	pa = range_alloc(pool_free, &pool_free_count, size);
 	if (pa == 0) {
+		if (OSAddAtomic64(1, &pool_fails) < 20) {
+			IOLog("TopazGPU: pool has no room for %llu KB (in use %llu MB, peak %llu MB of %llu MB)\n",
+			    size >> 10, (uint64_t)pool_used_bytes >> 20, (uint64_t)pool_peak_bytes >> 20,
+			    (uint64_t)GPU_POOL_SIZE >> 20);
+		}
 		return 0;
 	}
 	unsigned c = (unsigned)((pa - GPU_POOL_BASE) / GPU_POOL_CHUNK);
@@ -278,6 +286,19 @@
 	if (va != NULL) {
 		*va = gpu_chunk_va[c] + (pa - GPU_POOL_BASE - c * GPU_POOL_CHUNK);
 	}
+	{
+		OSAddAtomic64(1, &pool_allocs);
+		SInt64 now = OSAddAtomic64((SInt64)size, &pool_used_bytes) + (SInt64)size;
+
+		if (now > pool_peak_bytes) {
+			pool_peak_bytes = now;
+		}
+		if ((uint64_t)pool_peak_bytes >= pool_logged_peak + (32ull << 20)) {
+			pool_logged_peak = (uint64_t)pool_peak_bytes;
+			IOLog("TopazGPU: pool in use %llu MB, peak %llu MB of %llu MB\n", (uint64_t)now >> 20,
+			    (uint64_t)pool_peak_bytes >> 20, (uint64_t)GPU_POOL_SIZE >> 20);
+		}
+	}
 	return pa;
 }
 
@@ -295,6 +316,19 @@
 	size = (size + GPU_POOL_UNIT - 1) & ~(GPU_POOL_UNIT - 1);
 	if (pa >= GPU_POOL_BASE && pa + size <= GPU_POOL_BASE + GPU_POOL_SIZE) {
+		for (unsigned i = 0; i < pool_free_count; i++) {
+			if (pa < pool_free[i].start + pool_free[i].size && pool_free[i].start < pa + size) {
+				if (OSAddAtomic64(1, &pool_dbl) < 20) {
+					IOLog("TopazGPU: pool double free %#llx %llu KB, overlaps free %#llx %llu KB\n", pa, size >> 10, pool_free[i].start, pool_free[i].size >> 10);
+				}
+				return;
+			}
+		}
 		range_free(pool_free, &pool_free_count, 2048, pa, size);
+		SInt64 used = OSAddAtomic64(-(SInt64)size, &pool_used_bytes) - (SInt64)size;
+		SInt64 n = OSAddAtomic64(1, &pool_frees) + 1;
+		if (n <= 8 || (n % 32) == 0) {
+			IOLog("TopazGPU: pool free #%lld %llu KB: in use %llu MB, allocs %lld\n", n, size >> 10, (uint64_t)used >> 20, (SInt64)pool_allocs);
+		}
 	}
 }
 /* boot-arg gpu_identity (default 1): the SMMU passes addresses through (TopazGpuW G1), GPU VA = PA */
