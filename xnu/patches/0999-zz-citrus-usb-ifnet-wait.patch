 }
 
+/*
+ * sweetusbnet=1 (with sweetusbraw=1): ue0 for IP, so that something can be reached over the cable (ssh).
+ * The network stack's zones are made by dlil_init, which runs more than 25 s after this probe: the
+ * first ifnet made here panicked in dlil_if_acquire (dlif_zone NULL), after 20 s as well. launchd
+ * (initproc) starts after dlil_init and lo0: wait for it, then a few seconds more.
+ */
+extern struct proc *initproc;
+extern kern_return_t thread_terminate(thread_t);
+
+static void
+ud_net_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (int i = 0; i < 3000 && initproc == NULL; i++) {
+		ud_sleep_ms(100);
+	}
+	if (initproc == NULL) {
+		printf("SWEET USB: launchd not seen in 300 s, no ue0\n");
+	} else {
+		for (int i = 0; i < 3000; i++) {
+			ud_sleep_ms(1);
+		}
+		printf("SWEET USB: creating ue0 (launchd is running)\n");
+		ud_if_create();
+	}
+	thread_terminate(current_thread());
+}
+
 static void
 sweet_usb_gadget_start(vm_offset_t dwc)
 {
@@ -1070,6 +1099,18 @@
 
 		ud.lock = lck_mtx_alloc_init(g, LCK_ATTR_NULL);
 		printf("SWEET USB: raw log mode (no ifnet)\n");
+		{
+			int net = 0;
+
+			PE_parse_boot_argn("sweetusbnet", &net, sizeof(net));
+			if (net) {
+				thread_t nt;
+
+				if (kernel_thread_start(ud_net_thread, NULL, &nt) == KERN_SUCCESS) {
+					thread_deallocate(nt);
+				}
+			}
+		}
 	} else {
 		ud_if_create();
 	}
