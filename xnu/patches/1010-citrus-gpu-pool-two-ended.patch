+/* like range_alloc, but from the end of the highest range: small buffers pile up at the top of the pool, away from the big surfaces */
+static uint64_t
+range_alloc_top(void *table, unsigned *count, uint64_t size)
+{
+	struct r { uint64_t start, size; } *f = (struct r *)table;
+
+	for (unsigned i = *count; i-- > 0;) {
+		if (f[i].size >= size) {
+			uint64_t address = f[i].start + f[i].size - size;
+			f[i].size -= size;
+			if (f[i].size == 0) {
+				memmove(&f[i], &f[i + 1], (--*count - i) * sizeof(f[0]));
+			}
+			return address;
+		}
+	}
+	return 0;
+}
