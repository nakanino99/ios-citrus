--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -921,6 +921,55 @@
 extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
 extern uint64_t sweet_log_position(void);
 
+/*
+ * sweetusbraw=1: the network stack (dlil) is not initialised on this kernel, so
+ * skip ifnet/UDP and send the log as raw Ethernet frames (ethertype 0x88b5,
+ * broadcast) straight onto the bulk IN endpoint.
+ */
+static int ud_raw;
+
+static void
+ud_rawlog_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t pos = sweet_log_position();
+	int ms = 10;
+
+	(void)PE_parse_boot_argn("sweetusblogms", &ms, sizeof(ms));
+	if (ms < 1) {
+		ms = 1;
+	}
+	pos = pos > 65536 ? pos - 65536 : 0;
+	for (;;) {
+		ud_sleep_ms(ms);
+		if (!ud.configured) {
+			continue;
+		}
+		lck_mtx_lock(ud.lock);
+		if (ud.tx_busy || !ud.configured) {
+			lck_mtx_unlock(ud.lock);
+			continue;
+		}
+		uint8_t *f = (uint8_t *)(ud.dma + UD_TX);
+		uint32_t n = sweet_log_copy(&pos, (char *)(f + 14), 1400);
+		if (n == 0) {
+			lck_mtx_unlock(ud.lock);
+			continue;
+		}
+		memset(f, 0xff, 6);
+		memcpy(f + 6, ud_phone_mac, 6);
+		f[12] = 0x88;
+		f[13] = 0xb5;
+		size_t len = 14 + n;
+		if ((len % 512) == 0) {
+			f[len++] = 0;
+		}
+		ud.tx_busy = true;
+		ud.tx_frames++;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL);
+		lck_mtx_unlock(ud.lock);
+	}
+}
+
 static void
 ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 {
@@ -981,7 +1030,16 @@
 		return;
 	}
 	ud.dma_pa = ptoa_64(pn);
-	ud_if_create();
+	ud_raw = 0;
+	PE_parse_boot_argn("sweetusbraw", &ud_raw, sizeof(ud_raw));
+	if (ud_raw) {
+		lck_grp_t *g = lck_grp_alloc_init("sweet_usb", LCK_GRP_ATTR_NULL);
+
+		ud.lock = lck_mtx_alloc_init(g, LCK_ATTR_NULL);
+		printf("SWEET USB: raw log mode (no ifnet)\n");
+	} else {
+		ud_if_create();
+	}
 
 	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
 	dwc_wr(DCTL, DCTL_CSFTRST);
@@ -1041,7 +1099,11 @@
 	}
 	int livelog = 1;
 	PE_parse_boot_argn("sweetusblog", &livelog, sizeof(livelog));
-	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
+	if (livelog && ud_raw) {
+		if (kernel_thread_start(ud_rawlog_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	} else if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
 }
