+/* Diagnostic: last submission number, the fence value the GPU last wrote to mem+0, ring pointers, RBBM_STATUS. */
+extern "C" void
+redwood_gpu_state(uint32_t *seq, uint32_t *fence, uint32_t *rptr, uint32_t *wptr_out, uint32_t *rbbm)
+{
+	*seq = seqno;
+	*fence = 0;
+	if (mem.va != NULL) {
+		sweet_dcache_flush((vm_offset_t)mem.va, 64);
+		*fence = *(volatile uint32_t *)mem.va;
+	}
+	*rptr = ready ? gpu_rd(0x806) : 0;
+	*wptr_out = wptr % RB_DWORDS;
+	*rbbm = ready ? gpu_rd(0x210) : 0;
+}
