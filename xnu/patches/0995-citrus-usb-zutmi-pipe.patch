--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1091,6 +1091,25 @@
 			    dwc_rd(GCTL), dwc_rd(0xc200), dwc_rd(0xc2c0));
 		}
 	}
+	/* sweetusbutmi=1: dwc3_qcom_select_utmi_clk() from mainline: UTMI clock as PIPE clock (no SS PHY clock). */
+	{
+		int utmi = 0;
+
+		PE_parse_boot_argn("sweetusbutmi", &utmi, sizeof(utmi));
+		if (utmi) {
+			vm_offset_t q = ml_io_map(QSCRATCH_PA, 0x100);
+
+			if (q != 0) {
+				printf("SWEET USB: QSCRATCH GENERAL_CFG before 0x%08x\n", usb_rd(q, 0x08));
+				cu_wr(q, 0x08, usb_rd(q, 0x08) | (1u << 8));                    /* PIPE_UTMI_CLK_DIS */
+				delay(200);
+				cu_wr(q, 0x08, usb_rd(q, 0x08) | (1u << 0) | (1u << 3));       /* PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW */
+				delay(200);
+				cu_wr(q, 0x08, usb_rd(q, 0x08) & ~(1u << 8));
+				printf("SWEET USB: QSCRATCH GENERAL_CFG after 0x%08x\n", usb_rd(q, 0x08));
+			}
+		}
+	}
 	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
 	dwc_wr(DCTL, DCTL_CSFTRST);
 	int i;
