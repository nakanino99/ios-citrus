+/* ifnet must not be created during early boot (zalloc/dlil not ready): wait first. */
+static void
+ud_net_thread(void *arg __unused, wait_result_t w __unused)
+{
+	int ms = 15000, livelog = 1;
+	thread_t t;
+
+	(void)PE_parse_boot_argn("sweetusbnetdelay", &ms, sizeof(ms));
+	if (ms < 1000) {
+		ms = 1000;
+	}
+	for (int i = 0; i < ms; i++) {
+		ud_sleep_ms(1);
+	}
+	ud_if_create();
+	PE_parse_boot_argn("sweetusblog", &livelog, sizeof(livelog));
+	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+	thread_terminate(current_thread());
+}
