+/* citrus: ABL leaves the USB30_PRIM GDSC and most clocks off; bring them up here. */
+static void
+cu_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+cu_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t val)
+{
+	for (int i = 0; i < 1000; i++) {
+		if ((usb_rd(base, off) & mask) == val) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static void
+cu_rcg(vm_offset_t gcc, uint32_t cmd, uint32_t cfg, const char *name)
+{
+	cu_wr(gcc, cmd + 4, cfg);
+	cu_wr(gcc, cmd, usb_rd(gcc, cmd) | 1u);
+	printf("SWEET USB: rcg %s cfg 0x%08x update %s\n", name, cfg,
+	    cu_poll(gcc, cmd, 1u, 0) ? "ok" : "timeout");
+}
+
+static void
+citrus_usb_power_on(vm_offset_t gcc)
+{
+	/* GPLL0 (master clock parent): vote and report lock */
+	cu_wr(gcc, 0x79000, usb_rd(gcc, 0x79000) | 1u);
+	printf("SWEET USB: GPLL0 mode 0x%08x vote 0x%08x\n", usb_rd(gcc, 0x0), usb_rd(gcc, 0x79000));
+
+	/* GDSC: clear SW_COLLAPSE, wait PWR_ON */
+	cu_wr(gcc, GCC_USB30_PRIM_GDSCR, usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & ~1u);
+	printf("SWEET USB: GDSC power-on %s\n",
+	    cu_poll(gcc, GCC_USB30_PRIM_GDSCR, 1u << 31, 1u << 31) ? "ok" : "timeout");
+
+	/* BCR pulse */
+	cu_wr(gcc, 0x1a000, 1);
+	delay(100);
+	cu_wr(gcc, 0x1a000, 0);
+	delay(100);
+
+	/* RCG master: GPLL0_OUT_AUX2 (src 2) / 4.5 (HID 8) = 66.67 MHz; utmi: XO */
+	cu_rcg(gcc, 0x1a01c, (2u << 8) | 8u, "master");
+	cu_rcg(gcc, 0x1a034, 0, "utmi");
+
+	static const struct {
+		const char *name;
+		uint32_t    off;
+	} br[] = {
+		{ "aggre-axi", 0x1a080 }, { "cfg-noc-axi", 0x1a084 }, { "ahb2phy", 0x1d008 },
+		{ "master", 0x1a010 }, { "sleep", 0x1a014 }, { "utmi", 0x1a018 }, { "clkref", 0x9f000 },
+	};
+	for (unsigned i = 0; i < sizeof(br) / sizeof(br[0]); i++) {
+		cu_wr(gcc, br[i].off, usb_rd(gcc, br[i].off) | 1u);
+		printf("SWEET USB: branch %-12s %s\n", br[i].name,
+		    cu_poll(gcc, br[i].off, CBCR_CLK_OFF, 0) ? "on" : "timeout");
+	}
+}
