 	if (ret != kIOReturnSuccess) {
@@ -1720,6 +1723,9 @@ IOSurfaceRootUserClient::trapRelease(void *id, void *, void *, void *, void *, v
 	if (ref == NULL) {
 		ref = findRef((uint32_t)(uintptr_t)id, &index);
 	}
+	if (ref != NULL) {
+	    OSIncrementAtomic((volatile SInt32 *)&sweet_surface_nrel);
+	}
 	if (ref != NULL && --ref->count == 0) {
 		/*
 		 * The pixels are unmapped now; the state page (read-only) stays mapped a while.
@@ -1731,6 +1737,17 @@ IOSurfaceRootUserClient::trapRelease(void *id, void *, void *, void *, void *, v
 		 */
 		OSSafeReleaseNULL(ref->data);
 		sweet_surface_put(ref->surface);
+		{
+		    static int rel = -1;
+		    if (rel < 0) {
+		        uint32_t on = 0;
+		        rel = PE_parse_boot_argn("sweetzombierel", &on, sizeof(on)) && on != 0;
+		    }
+		    if (rel) {
+		        /* a zombie keeps only the state page, not the whole surface */
+		        OSSafeReleaseNULL(ref->surface);
+		    }
+		}
 		ref->released = true;
 		ref->detached = false;
