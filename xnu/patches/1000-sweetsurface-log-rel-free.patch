 	}
@@ -1174,10 +1176,11 @@ IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 		char name[32];
 		proc_selfname(name, sizeof(name));
 		sweet_surface_creates_logged++;
-		IOLog("SWEET SURF: %s create id %u %ux%u fmt 0x%x bpe %u bpr %u planes %u size %u keys %u -> 0x%x wired %lluMB nextid %u\n",
+		IOLog("SWEET SURF: %s create id %u %ux%u fmt 0x%x bpe %u bpr %u planes %u size %u keys %u -> 0x%x wired %lluMB nextid %u rel %u free %u\n",
 		    name, s->id, s->width, s->height, s->pixelFormat, s->bytesPerElement,
