diff --git a/iokit/Kernel/arm/RedwoodGPU.cpp b/iokit/Kernel/arm/RedwoodGPU.cpp
index a4e5569..e23b5c5 100644
--- a/iokit/Kernel/arm/RedwoodGPU.cpp
+++ b/iokit/Kernel/arm/RedwoodGPU.cpp
@@ -966,6 +966,13 @@ RedwoodGPUUserClient::surfaceBuffer(struct redwood_surface * request)
 		b->kernel = (uint8_t *) s->kernelAddress();
 		b->surface = s;
 		gGPUStat.surfaces++;
+		{
+		    static uint32_t sb_n;
+		    if ((++sb_n & 15) == 0) {
+		        IOLog("RedwoodGPU: client %#llx surface buffers made %u, now %u buffers %llu MB\n",
+		            (unsigned long long)(uintptr_t)this, sb_n, (unsigned)fBufferCount, (unsigned long long)(fBufferBytes >> 20));
+		    }
+		}
 	}
 	gGPUStat.taking += mach_absolute_time() - began;
 	IOLockUnlock(gGPULock);
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
