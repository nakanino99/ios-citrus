@@ -287,6 +288,7 @@ OSDefineMetaClassAndStructors(SweetSurface, OSObject);
 void
 SweetSurface::free()
 {
+	OSIncrementAtomic((volatile SInt32 *)&sweet_surface_nfree);
 	if (OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL) {
